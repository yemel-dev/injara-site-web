# Boîte e-mail qui envoie les demandes du formulaire de contact (SMTP Spacemail)
SMTP_USER=team@injara.site
SMTP_PASS=
# Facultatif : SMTP_HOST=mail.spacemail.com, SMTP_PORT=465, CONTACT_TO=autre@adresse
# URL publique du site (par défaut https://injara.site en production)
NEXT_PUBLIC_SITE_URL=
# Code de vérification Google Search Console (méthode « Balise HTML », la valeur de content="...")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
